EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bakong KHQR payments
BAKONG_ACCOUNT_ID=
BAKONG_ACCOUNT_NAME=
BAKONG_ACCOUNT_CITY=
BAKONG_API_TOKEN=
